{
    "require": {
        "stefangabos/zebra_pagination": "^2.4",
        "dompdf/dompdf": "^3.1",
        "php-di/php-di": "^7.1",
        "mikey179/vfsstream": "^1.6"
        
    },
    
    "config": {
        "platform": {
            "php": "8.3"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },

    "autoload": {
        "classmap": [
            "businessComponents/",
            "config/",
            "controllers/",
            "factories/",
            "helper/",
            "models/",
            "verifications/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "pestphp/pest": "^4.7"
    }
}
